@model FirstWebMVC.Models.Product

@{
    // Gán tiêu đề trang từ ViewBag vào layout chung
    ViewData["Title"] = ViewBag.PageTitle;
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item active">@ViewBag.PageTitle</li>
        </ol>
    </nav>

    <div class="alert alert-info">
        <strong>Khuyến mãi:</strong> @ViewBag.PromotionMessage
    </div>

    <h2>@Model.Name</h2>
    <p>Giá: <strong class="text-danger">@Model.Price.ToString("C")</strong></p>

    <hr />
    
    @if (ViewBag.IsAvailable)
    {
        <p class="text-success">Tình trạng: Còn hàng</p>
    }

    <footer>
        <small>Cập nhật lần cuối: @ViewBag.LastUpdated</small>
    </footer>
</div>